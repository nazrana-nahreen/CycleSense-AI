# ==============================================================================
# CycleSense AI — Backend Configuration (.env)
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# Default: SQLite database for immediate zero-config local development and testing.
# For PostgreSQL (production or local Postgres service):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyclesense_db
DATABASE_URL=sqlite:///./cyclesense.db

# JWT & Authentication Security
# Generate a strong 32-byte secret for production (e.g., `openssl rand -hex 32`)
SECRET_KEY=cyclesense_capstone_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# CORS Settings
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Host & Port
HOST=127.0.0.1
PORT=8000
